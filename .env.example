# Copy this file to .env.local and set your own values.
# .env.local is gitignored, is read on the server only, and never reaches the browser.

# The code that opens order management.
# To change it: edit this line, restart the server. That's the whole process.
# Changing it also signs everyone out.
ADMIN_ACCESS_CODE=change-me

# Optional. Signs the session cookie.
# Leave it out and a key is derived from the access code, which is fine locally.
# Set it explicitly before hosting this anywhere public:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=
