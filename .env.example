# Copy this file to .env.local and set your own values.
# .env.local is gitignored, is read on the server only, and never reaches the browser.

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# The code that opens order management.
# Locally you can skip this and put the code in admin-code.txt instead.
# On Vercel this env var IS the code — there's no file to read.
# Changing it signs everyone out.
ADMIN_ACCESS_CODE=change-me

# Signs the session cookie. Required once this is hosted: without it a key is
# derived from the access code, which means changing the code silently
# invalidates every session, and two deployments sharing a code share a key.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# The manufacturer's code for the factory sheets (/factory/<token>). Locally it
# can live in factory-code.txt instead. Must differ from the admin code, or the
# factory sheet refuses to open.
# FACTORY_ACCESS_CODE=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Set BOTH of these and the app uses Supabase for data and artwork. Leave both
# unset and it falls back to data/db.json plus public/uploads — which is fine
# on a laptop and useless on Vercel, where the filesystem is read-only and
# vanishes on every deploy.
#
# The service role key bypasses row-level security. It is a master key to the
# whole database: server-side only, never prefixed NEXT_PUBLIC_, never pasted
# anywhere a browser can see. Rotate it in the Supabase dashboard if it leaks.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Links
# ---------------------------------------------------------------------------

# Used to build the share and client links you copy out of an order. Set it to
# the real domain once deployed, or every link you send a customer will point
# at localhost.
# NEXT_PUBLIC_BASE_URL=https://orders.powerplaycustoms.ca

# ---------------------------------------------------------------------------
# Customer confirmation email (website enquiries)
# ---------------------------------------------------------------------------

# With both set, every enquiry from the website's order page gets a
# confirmation email carrying the team's own page link (src/lib/intake-confirm.ts).
# Leave them unset and nothing is sent: the enquiry still becomes a Draft and
# Keenan's Shopify email still arrives.
#
# Google Workspace: SMTP_USER is the mailbox and SMTP_PASS is an App password
# (Google Account > Security > 2-Step Verification > App passwords) — never the
# mailbox's real password. Any other SMTP provider works by changing the host.
# SMTP_USER=info@powerplaycustoms.ca
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Powerplay Customs <info@powerplaycustoms.ca>
# MAIL_REPLY_TO=info@powerplaycustoms.ca
# Copy of every confirmation to the business mailbox. Set it when sending through a
# provider such as Resend (SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=the API key,
# MAIL_FROM on the verified domain), where nothing lands in the mailbox's Sent folder.
# MAIL_BCC=info@powerplaycustoms.ca

# ---------------------------------------------------------------------------
# Roster files read by AI
# ---------------------------------------------------------------------------

# Reads a roster PDF or a photo of a list (twice, compared cell by cell) and
# double-checks which column of a spreadsheet is which. Server-side only —
# never prefix it NEXT_PUBLIC_. Without it, spreadsheets and CSVs still import
# on their headings alone (with more questions), and a PDF or photo says it
# needs this. Create one at console.anthropic.com > API Keys.
# ANTHROPIC_API_KEY=
# Which model reads them. Defaults to claude-opus-5-5, the most careful; a
# faster one (claude-sonnet-5-5) if a long roster ever times out.
# ROSTER_AI_MODEL=
