node_modules/
.next/
out/
*.log
*.tsbuildinfo

# Secrets. Neither of these belongs in a repo — the hosted app reads
# ADMIN_ACCESS_CODE and SESSION_SECRET from the environment instead.
.env*.local
admin-code.txt

# Local JSON store. Real data lives in Supabase once hosted; this file is a
# dev convenience and would be a merge conflict on every commit.
data/db.json

# Uploaded artwork. Customer IP, sometimes large, and it belongs in the
# storage bucket rather than in git history where it can never be removed.
public/uploads/

# Scratch. The device bridge can't delete files, so things to bin land here.
_to_delete/

# Generated by Next on every run, and it differs between dev and build —
# committing it means a phantom change in every diff.
next-env.d.ts
